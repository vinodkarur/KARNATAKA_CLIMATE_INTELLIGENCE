# ==============================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Karnataka Climate Intelligence & Emergency Response Platform
# Copy this file to .env and customize with your local configuration.
# ==============================================================

# --------------------------------------------------------------
# 1. Server & Security Configuration
# --------------------------------------------------------------
PORT=5000
FLASK_ENV=production
SECRET_KEY=kci-enterprise-secret-key-change-in-production-2026
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
PERMANENT_SESSION_LIFETIME_HOURS=24

# --------------------------------------------------------------
# 2. MySQL Database Configuration
# --------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=elnino_karnataka_db
MYSQL_POOL_SIZE=10

# --------------------------------------------------------------
# 3. Meteorological Forecasting Service (Open-Meteo)
# --------------------------------------------------------------
# Open-Meteo provides free non-commercial access without API keys.
# For commercial high-volume enterprise SLAs, specify your custom endpoint or key:
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_TIMEOUT_SECONDS=10
WEATHER_CACHE_TTL_MINUTES=15

# --------------------------------------------------------------
# 4. Google Gemini Generative AI Integration
# --------------------------------------------------------------
# Optional: system provides high-fidelity offline fallback if omitted
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --------------------------------------------------------------
# 5. Web Push Notification Infrastructure (VAPID)
# --------------------------------------------------------------
# Generate VAPID key pairs with py_vapid or web-push:
VAPID_PUBLIC_KEY=BExampleVAPIDPublicKeyReplaceWithRealBase64URLKeyInProduction==
VAPID_PRIVATE_KEY=ExampleVAPIDPrivateKeyReplaceInProduction==
VAPID_CLAIMS_SUB=mailto:admin@karnataka-emergency.gov.in

# --------------------------------------------------------------
# 6. Emergency SMS Gateway (Twilio / CDAC / Trai DLT)
# --------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC_dummy_account_sid_for_enterprise_sms
TWILIO_AUTH_TOKEN=dummy_auth_token_for_enterprise_sms
TWILIO_SENDER_NUMBER=+15551234567

# --------------------------------------------------------------
# 7. Emergency Email Gateway (SMTP / SendGrid)
# --------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@karnataka-emergency.gov.in
SMTP_PASSWORD=dummy_app_specific_password
SMTP_FROM_NAME="Karnataka Emergency Operations Centre"

# --------------------------------------------------------------
# 8. Seeded Emergency Administration Credentials (Defaults)
# --------------------------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@karnataka-emergency.gov.in
DEFAULT_ADMIN_PASSWORD=Admin@KCI2026!
DEFAULT_CITIZEN_EMAIL=citizen@karnataka-emergency.gov.in
DEFAULT_CITIZEN_PASSWORD=Citizen@KCI2026!
